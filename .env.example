# ---- TeamSpeak ----------------------------------------------------------
TS_ADDRESS=ts.example.com            # host[:port], TS3 or TS6 server
TS_NAME=Hörbert                      # bot nickname
#TS_CHANNEL=Lounge/Music             # channel path to join (default: server default channel)
#TS_CHANNEL_PASSWORD=
#TS_SERVER_PASSWORD=

# ---- Web UI -------------------------------------------------------------
WEB_BIND=0.0.0.0:8080
PUBLIC_URL=http://your-host:8080     # shown by the !link / !help chat command
#WEB_KEY=                            # web ui key; generated into DATA_DIR/web_key if unset

# ---- Playback -----------------------------------------------------------
DEFAULT_VOLUME=0.1                   # 0.0 – 1.5
OPUS_BITRATE=128000
SPONSORBLOCK=true
SPONSORBLOCK_CATEGORIES=sponsor,selfpromo,interaction,music_offtopic
COMMAND_PREFIX=!
#HELP_SUFFIX=Requests? Ping Max\nHave fun!   # appended to !help, \n = line break
#SOUNDBOARD_FILE=/data/sounds.json  # soundboard clips, see README
#SOUNDBOARD_VOLUME=5                # sound loudness relative to the music
#HISTORY_HOURS=168                  # forget history older than this (7 days)

# ---- Text to speech (espeak-ng) -----------------------------------------
#TTS=true                           # !tts and the web ui's "say" box
#TTS_VOICE=en                       # espeak-ng language[+variant], e.g. de, en+klatt
#TTS_SPEED=160                      # words per minute
#TTS_MAX_CHARS=200                  # longer messages are cut
#TTS_COOLDOWN=10                    # seconds between two messages per user
#TTS_VOLUME=4                       # speech loudness relative to the music
#TTS_DUCK=0.3                       # music gain while speaking (1 = no ducking)
#GREET=true                         # say hi when someone joins the channel
#GREETINGS_FILE=/data/greetings.json # greetings, created with defaults, see README

# ---- yt-dlp -------------------------------------------------------------
# Extra args appended to every yt-dlp call. Examples:
#   --cookies /data/cookies.txt
#   --extractor-args "youtube:player_client=default,web_embedded,android_vr"
#   --extractor-args "youtubepot-bgutilhttp:base_url=http://bgutil:4416"
#YTDLP_ARGS=
YTDLP_AUTO_UPDATE=true               # pip -U yt-dlp on every container start

# RUST_LOG=info,hoerbert=debug
