# ---- TeamSpeak ----------------------------------------------------------
TS_ADDRESS=ts.example.com            # host[:port], TS3 or TS6 server
TS_NAME=Hörbert                      # bot nickname
#TS_CHANNEL=Lounge/Music             # channel path to join (default: server default channel)
#TS_CHANNEL_PASSWORD=
#TS_SERVER_PASSWORD=

# ---- Web UI -------------------------------------------------------------
WEB_BIND=0.0.0.0:8080
PUBLIC_URL=http://your-host:8080     # shown by the !link / !help chat command

# ---- Playback -----------------------------------------------------------
DEFAULT_VOLUME=0.5                   # 0.0 – 1.5
OPUS_BITRATE=128000
SPONSORBLOCK=true
SPONSORBLOCK_CATEGORIES=sponsor,selfpromo,interaction,music_offtopic
COMMAND_PREFIX=!

# ---- yt-dlp -------------------------------------------------------------
# Extra args appended to every yt-dlp call. Examples:
#   --cookies /data/cookies.txt
#   --extractor-args "youtube:player_client=default,web_embedded,android_vr"
#   --extractor-args "youtubepot-bgutilhttp:base_url=http://bgutil:4416"
#YTDLP_ARGS=
YTDLP_AUTO_UPDATE=true               # pip -U yt-dlp on every container start

# RUST_LOG=info,hoerbert=debug
